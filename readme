그냥 새로 만들기

CREATE TABLE juso_master1
(
    road_address_id String COMMENT '도로명주소관리번호',
    bjdong_code String COMMENT '법정동코드',
    sido String COMMENT '시도명',
    sigungu String COMMENT '시군구명',
    bjdong_name String COMMENT '법정읍면동명',
    ri_name String COMMENT '법정리명',
    is_mountain String COMMENT '산여부 (0:대지, 1:산)',
    jibun_main UInt32 COMMENT '지번본번(번지)',
    jibun_sub UInt32 COMMENT '지번부번(호)',
    road_code String COMMENT '도로명코드',
    road_name String COMMENT '도로명',
    is_underground String COMMENT '지하여부 (0:지상, 1:지하, 2:공중, 3:수상)',
    building_main UInt32 COMMENT '건물본번',
    building_sub UInt32 COMMENT '건물부번',
    hjdong_code String COMMENT '행정동코드',
    hjdong_name String COMMENT '행정동명',
    zip_code String COMMENT '기초구역번호(우편번호)',
    prev_road_address String COMMENT '이전도로명주소',
    effective_date String COMMENT '효력발생일',
    apartment_type String COMMENT '공동주택구분',
    move_reason_code String COMMENT '이동사유코드',
    building_name_register String COMMENT '건축물대장건물명',
    building_name_sigungu String COMMENT '시군구용건물명',
    remarks String COMMENT '비고',

    -- 도로명과 지번 주소 형태를 모두 담는 통합 검색 컬럼
    -- 예: "서울 강남구 역삼동 테헤란로 152 역삼동 737 강남파이낸스센터" 형태로 자동 빌드됨
    full_address String MATERIALIZED concat(
        sido, ' ', 
        sigungu, ' ', 
        bjdong_name, ' ',
        road_name, ' ', 
        toString(building_main), if(building_sub > 0, concat('-', toString(building_sub)), ''),
        if(building_name_sigungu = '', '', concat(' ', building_name_sigungu))
    ) COMMENT '도로명 검색용 텍스트',
    full_address1 String MATERIALIZED concat(
        sido, ' ', 
        sigungu, ' ', 
        bjdong_name, if(ri_name != '', concat(' ', ri_name), ''), ' ',
        if(is_mountain = '1', '산 ', ''),
        toString(jibun_main), if(jibun_sub > 0, concat('-', toString(jibun_sub)), ''),
        if(building_name_sigungu = '', '', concat(' ', building_name_sigungu))
    ) COMMENT '지번 검색용 텍스트',

    -- 고속 텍스트 검색을 위한 역인덱스
    INDEX idx_full_address(full_address) TYPE text(tokenizer = 'splitByNonAlpha') GRANULARITY 1,
    INDEX idx_full_address1(full_address1) TYPE text(tokenizer = 'splitByNonAlpha') GRANULARITY 1
)
ENGINE = MergeTree
ORDER BY (sido, sigungu, bjdong_name, road_name, road_address_id);

insert into juso_master1 select * from juso_master;


SELECT *
FROM juso_master1 AS X
WHERE hasAllTokens(X.full_address, ['도천리', '133']) or hasAllTokens(X.full_address1, ['도천리', '133'])




SELECT 'A' as gubun, A.zip_code as "기초구역번호",
A.road_address_id as "도로명주소관리번호", A.bjdong_code as "법정동코드", A.sido as "시도명", A.sigungu as "시군구명",
A.bjdong_name as "읍면동명", A.ri_name as "리명", A.is_mountain as "산여부", A.road_code as "도로명코드", A.road_name as "도로명",
A.jibun_main as "지번본번", A.jibun_sub as "지번부번", A.apartment_type as "공동주택여부", A.building_name_register as "건물대장건물명",
A.is_underground as "지하여부", A.building_main as "건물본번", A.building_sub as "건물부번", A.building_name_sigungu as "건물명"
FROM juso_master1 A
WHERE hasAllTokens(A.full_address, ['도천리', '133']) or hasAllTokens(A.full_address1, ['도천리', '133'])
union all
Select 'B' as gubun, A.zip_code as "기초구역번호",
X.road_address_id as "도로명주소관리번호", X.bjdong_code as "법정동코드", X.sido as "시도명", X.sigungu as "시군구명",
X.bjdong_name as "읍면동명", X.ri_name as "리명", X.is_mountain as "산여부", A.road_code as "도로명코드", A.road_name as "도로명",
X.jibun_main as "지번본번", X.jibun_sub as "지번부번", A.apartment_type as "공동주택여부", A.building_name_register as "건물대장건물명",
A.is_underground as "지하여부", A.building_main as "건물본번", A.building_sub as "건물부번", A.building_name_sigungu as "건물명"
From juso_jibun_master X
inner join juso_master1 A on A.road_address_id = X.road_address_id and hasAllTokens(X.full_address, ['도천리', '133'])
;


