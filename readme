SELECT 
    sido, sigungu, road_name, building_main, building_sub, 
    bjdong_name, jibun_main, jibun_sub, building_name_sigungu
FROM juso_master 
-- ['테헤란로', '152'] 두 토큰이 모두 full_address 인덱스에 있는 행을 초고속 스캔
WHERE hasAllTokens(full_address, ['테헤란로', '152'])
LIMIT 20;


SELECT 
    sido, sigungu, road_name, building_main, building_sub, 
    bjdong_name, jibun_main, jibun_sub, building_name_sigungu
FROM juso_master 
WHERE hasAllTokens(full_address, ['장제로156번길'])
LIMIT 20;



SELECT 
    sido, sigungu, road_name, building_main, building_sub,
    bjdong_name, jibun_main, jibun_sub, building_name_sigungu,
    -- 매칭 정확도 점수 (정확히 일치하는 항목을 위로 올리기 위함)
    (if(road_name = '테헤란로', 10, 0) + if(building_name_sigungu LIKE '%강남%', 5, 0)) AS score
FROM juso_master 
WHERE (
    -- 1순위: 쪼개진 단어가 역인덱스에 완벽 매칭되는지 (초고속)
    hasAllTokens(full_address, ['테헤란로', '152'])
) 
OR (
    -- 2순위: 인덱스를 못 타는 부분 불일치 단어는 LIKE 패턴 매칭으로 보완
    road_name LIKE '테헤%' AND full_address LIKE '%152%'
)
ORDER BY score DESC, road_name ASC 
LIMIT 30;




SELECT 
    sido, sigungu, road_name, building_main, building_sub,
    bjdong_name, jibun_main, jibun_sub, building_name_sigungu,
    -- 매칭 정확도 점수 (정확히 일치하는 항목을 위로 올리기 위함)
    (if(road_name = '장제로156번길', 10, 0) + if(building_name_sigungu LIKE '%대림아파트%', 5, 0)) AS score
FROM juso_master 
WHERE (
    -- 1순위: 쪼개진 단어가 역인덱스에 완벽 매칭되는지 (초고속)
    hasAllTokens(full_address, ['장제로156번길', '대림아파트'])
) 
OR (
    -- 2순위: 인덱스를 못 타는 부분 불일치 단어는 LIKE 패턴 매칭으로 보완
    road_name LIKE '장제로156번길%' AND full_address LIKE '%대림아파트%'
)
ORDER BY score DESC, road_name ASC 
LIMIT 30;




