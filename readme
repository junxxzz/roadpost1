A.road_address_id as "도로명주소관리번호", A.bjdong_code as "법정동코드", A.sido as "시도명", A.sigungu as "시군구명",
A.bjdong_name as "읍면동명", A.ri_name as "리명", A.is_mountain as "산여부", A.road_code as "도로명코드", A.road_name as "도로명",
A.jibun_main as "지번본번", A.jibun_sub as "지번부번", A.apartment_type as "공동주택여부", A.building_name_register as "건물대장건물명",
A.is_underground as "지하여부", A.building_main as "건물본번", A.building_sub as "건물부번", A.building_name_sigungu as "건물명"
FROM juso_master A
WHERE hasAllTokens(A.full_address, ['도천리', '133'])
union all
Select 'B' as gubun, A.zip_code as "기초구역번호",
X.road_address_id as "도로명주소관리번호", X.bjdong_code as "법정동코드", X.sido as "시도명", X.sigungu as "시군구명",
X.bjdong_name as "읍면동명", X.ri_name as "리명", X.is_mountain as "산여부", A.road_code as "도로명코드", A.road_name as "도로명",
X.jibun_main as "지번본번", X.jibun_sub as "지번부번", A.apartment_type as "공동주택여부", A.building_name_register as "건물대장건물명",
